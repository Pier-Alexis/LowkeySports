JWT_SECRET=change_me_in_production
PORT=3000
DB_USER=postgres
DB_HOST=localhost
DB_NAME=lowkeysports
DB_PASSWORD=your_password
DB_PORT=5432
# Emails autorisés à devenir administrateurs (séparés par des virgules)
ADMIN_EMAILS=admin@example.com,autre@example.com
# Bot Discord : publie les analyses publiées dans le canal du sport concerné
# (voir SPORT_CHANNEL_IDS / PRONOSTIC_CATEGORY_ID dans src/services/discordBot.ts)
# Le bot se connecte automatiquement (gateway) si le token est renseigné
# et enregistre ses commandes slash (/bilan, /matchs, /aide) sur le serveur de
# PRONOSTIC_CATEGORY_ID, ou sur le serveur ci-dessous si précisé.
# DISCORD_BOT_TOKEN=your_bot_token
# DISCORD_COMMANDS_GUILD_ID=your_guild_id
# NODE_ENV=production
